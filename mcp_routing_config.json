{
  "managed_servers": {
    "weather-service": {
      "command": "uv",
      "args": ["run", "weather-mcp-server"],
      "env": {
        "WEATHER_API_KEY": "${WEATHER_API_KEY}"
      }
    },
    "wikidata-monuments": {
      "command": "uv",
      "args": ["run", "python", "servers/wikidata_monuments.py"],
      "env": {}
    },
    "openstreetmap-overpass": {
      "command": "uv",
      "args": ["run", "python", "servers/openstreetmap_overpass.py"],
      "env": {}
    },
    "open-meteo-weather": {
      "command": "uv",
      "args": ["run", "python", "servers/open_meteo_weather.py"],
      "env": {}
    },
    "github-service": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}